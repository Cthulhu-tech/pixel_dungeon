{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "resolveJsonModule": true
  },
  "files": [
    "src/types/effects/buffs.d.ts",
    "src/modules/effects/index.ts",
    "src/types/effects/status.d.ts",
    "src/types/effects/resources.d.ts",
    "src/types/compatibility/random.d.ts",
    "src/types/effects/blobs.d.ts"
  ]
}
