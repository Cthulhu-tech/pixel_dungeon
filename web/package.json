{
  "name": "pixel-dungeon-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:compatibility": "tsc -p tsconfig.compatibility.json",
    "typecheck:kernel": "tsc -p tsconfig.kernel.json",
    "typecheck:turns": "tsc -p tsconfig.turns.json",
    "typecheck:character": "tsc -p tsconfig.character.json",
    "check:extraction:compatibility": "node tools/check-compatibility-extraction.mjs",
    "check:extraction:kernel": "node tools/check-kernel-extraction.mjs",
    "check:extraction:turns": "node tools/check-turns-extraction.mjs",
    "check:extraction:character": "node tools/check-character-extraction.mjs",
    "lint": "node tools/check-boundaries.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:contracts": "node --experimental-strip-types --test tests/contracts/*.test.mjs",
    "test:contracts:turns": "node --experimental-strip-types --test tests/contracts/turn-continuations.test.mjs",
    "test:parity": "node tools/parity-gate.mjs",
    "test:parity:random": "node --experimental-strip-types --test tests/parity/random.test.mjs tests/parity/random-collections.test.mjs",
    "test:parity:pathfinding": "node --experimental-strip-types --test tests/parity/pathfinding.test.mjs",
    "test:parity:ballistics": "node --experimental-strip-types --test tests/parity/ballistics.test.mjs",
    "test:parity:visibility": "node --experimental-strip-types --test tests/parity/visibility.test.mjs",
    "test:parity:turns": "node --experimental-strip-types --test tests/parity/turns.test.mjs",
    "test:parity:character": "node --experimental-strip-types --test tests/parity/character-source.test.mjs tests/parity/character.test.mjs",
    "test:parity:kernel": "node --experimental-strip-types --test tests/parity/*.test.mjs",
    "test:kernel": "node --experimental-strip-types --test tests/parity/*.test.mjs tests/contracts/*.test.mjs",
    "test:e2e": "node tools/browser-check-blocked.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "test:parity:navigation": "node --experimental-strip-types --test tests/parity/navigation.test.mjs",
    "audit:dependencies": "node tools/audit-dependency-pins.mjs",
    "typecheck:movement": "tsc -p tsconfig.movement.json",
    "check:extraction:movement": "node tools/check-movement-extraction.mjs",
    "typecheck:effects": "tsc -p tsconfig.effects.json",
    "check:extraction:effects": "node tools/check-effects-extraction.mjs",
    "test:parity:movement": "node --experimental-strip-types --test tests/parity/movement-source.test.mjs tests/parity/movement.test.mjs",
    "test:parity:buffs": "node --experimental-strip-types --test tests/parity/buffs.test.mjs",
    "test:parity:character-buffs": "node --experimental-strip-types --test tests/parity/character-buffs.test.mjs",
    "test:parity:status-effects": "node --experimental-strip-types --test tests/parity/status-effects.test.mjs",
    "test:parity:resource-effects": "node --experimental-strip-types --test tests/parity/resource-effects.test.mjs",
    "typecheck:run": "tsc -p tsconfig.run.json",
    "test:application": "node --experimental-strip-types --test tests/application/*.test.mjs"
  },
  "dependencies": {
    "phaser": "4.1.0",
    "phaser4-rex-plugins": "4.2.0",
    "xstate": "4.38.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
